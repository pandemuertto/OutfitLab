generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          String    @id @default(cuid())
  name        String
  description String?
  brand       String?
  color       String?
  size        String?
  season      String?
  categoryId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      Image[]
  category    Category? @relation(fields: [categoryId], references: [id])
  tags        ItemTag[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Image {
  id        String   @id @default(cuid())
  url       String
  mime      String?
  itemId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  items ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model Usuario {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  name              String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  isShared          Boolean            @default(false)
  CalendarEvent     CalendarEvent[]
  authProviders     AuthProvider[]
  prendas           Prenda[]
  exploreComments   ExploreComment[]
  exploreLikes      ExploreLike[]
  explorePosts      ExplorePost[]
  outfits           Outfit[]           @relation("UsuarioOutfits")
  outfitCollections OutfitCollection[] @relation("UsuarioOutfitCollections")

  @@map("usuario")
}

model AuthProvider {
  id         String  @id @default(cuid())
  provider   String
  providerId String  @map("provider_id")
  userId     String  @map("user_id")
  user       Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_providers")
}

model Prenda {
  id          Int            @id @default(autoincrement())
  userId      String         @map("user_id")
  imageUrl    String         @map("image_url")
  type        String?
  color       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  brand       String?
  category    String?
  confidence  Float?
  isAvailable Boolean        @default(true)
  isShared    Boolean        @default(false)
  user        Usuario        @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitPrenda[] @relation("PrendaOutfitItems")

  @@index([userId], map: "idx_clothes_user")
  @@index([category])
  @@map("clothes")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String
  prendaId  Int
  createdAt DateTime @default(now())

  @@unique([userId, prendaId])
  @@index([userId])
  @@index([prendaId])
}

model OutfitCollection {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  outfits     Outfit[]
  user        Usuario  @relation("UsuarioOutfitCollections", fields: [userId], references: [id], onDelete: Cascade)

  @@map("outfit_collection")
}

model Outfit {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  name          String?
  occasion      String?
  dressCode     String?
  weather       String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  collectionId  String?           @map("collection_id")
  isPublic      Boolean           @default(false)
  CalendarEvent CalendarEvent[]
  explorePosts  ExplorePost[]
  collection    OutfitCollection? @relation(fields: [collectionId], references: [id])
  user          Usuario           @relation("UsuarioOutfits", fields: [userId], references: [id], onDelete: Cascade)
  photos        OutfitPhoto[]
  items         OutfitPrenda[]

  @@map("outfit")
}

model OutfitPrenda {
  outfitId String @map("outfit_id")
  prendaId Int    @map("prenda_id")
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  prenda   Prenda @relation("PrendaOutfitItems", fields: [prendaId], references: [id], onDelete: Cascade)

  @@id([outfitId, prendaId])
  @@map("outfit_prenda")
}

model OutfitPhoto {
  id        String   @id @default(cuid())
  outfitId  String   @map("outfit_id")
  createdAt DateTime @default(now()) @map("created_at")
  url       String   @default("")
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@map("outfit_photo")
}

model ExplorePost {
  id        String           @id @default(cuid())
  outfitId  String           @map("outfit_id")
  imageUrl  String           @map("image_url")
  title     String
  likes     Int              @default(0)
  saves     Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at")
  userId    String           @map("user_id")
  style     String?
  comments  ExploreComment[]
  likesList ExploreLike[]
  outfit    Outfit           @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user      Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("explore_post")
}

model ExploreLike {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  postId    String      @map("post_id")
  createdAt DateTime    @default(now()) @map("created_at")
  post      ExplorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("explore_like")
}

model ExploreComment {
  id        String      @id @default(cuid())
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  userId    String      @map("user_id")
  postId    String      @map("post_id")
  post      ExplorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("explore_comment")
}

model CalendarEvent {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId        String
  title         String
  description   String?
  date          DateTime? @db.Timestamptz(6)
  startTime     String?
  endTime       String?
  outfitId      String?
  isTrip        Boolean   @default(false)
  destination   String?
  startDate     String?
  endDate       String?
  selectedClothes String[] @default([])
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  outfit        Outfit?   @relation(fields: [outfitId], references: [id], onUpdate: NoAction)
  user          Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date])
  @@index([userId])
}
