{
  "expo": {
    "name": "Closi",
    "slug": "outfit-lab",
    "version": "1.0.0",
    "scheme": "outfitlab",
    "orientation": "portrait",
    "icon": "./assets/images/closi_icon.png",
    "splash": {
      "image": "./assets/images/closi_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/closi_adaptive_icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.pandemuerttoo.outfitlab"
    },
    "web": {
      "favicon": "./assets/images/closi_favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/closi_splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e156ca6b-2c29-4a0b-b4ac-3314ce7c3763"
      }
    }
  }
}